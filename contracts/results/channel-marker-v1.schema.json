{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wlvdb.org/contracts/results/channel-marker-v1.schema.json",
  "title": "WLVDB append-only channel marker v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "channel",
    "sequence",
    "release_id",
    "release_manifest_path",
    "release_manifest_sha256",
    "published_at_utc"
  ],
  "properties": {
    "schema": { "const": "wlv-channel-marker" },
    "schema_version": { "const": "1" },
    "channel": {
      "type": "string",
      "pattern": "^(?=.{1,128}$)[a-z0-9](?:[a-z0-9._-]*[a-z0-9_-])?(?:/[a-z0-9](?:[a-z0-9._-]*[a-z0-9_-])?)*$"
    },
    "sequence": {
      "type": "string",
      "pattern": "^[0-9]{20}$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "release_manifest_path": {
      "type": "string",
      "pattern": "^releases/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/release_manifest\\.json$"
    },
    "release_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "published_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
